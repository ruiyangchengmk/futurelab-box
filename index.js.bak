// 检查登录状态
function isAuthorized(req) {
  return req.cookies && req.cookies.authorized === 'true';
}

// 需要 cookie-parser
const cookieParser = require('cookie-parser');
app.use(cookieParser());
app.use(cors());
app.use(express.static('public'));
app.use('/uploads', express.static('uploads'));

// ========== 断点续传接口 (需要登录) ==========

// 验证登录中间件
function requireAuth(req, res, next) {
  if (!req.cookies || req.cookies.authorized !== 'true') {
    return res.status(401).json({ error: '请先登录' });
  }
  next();
}

// 获取已上传的分片
app.get('/chunks/:fileId', requireAuth, (req, res) => {
  const { fileId } = req.params;
  const chunksDir = path.join(__dirname, 'chunks', fileId);
  
  if (!fs.existsSync(chunksDir)) {
    return res.json({ chunks: [] });
  }
  
  const files = fs.readdirSync(chunksDir);
  const chunks = files.map(f => parseInt(f)).filter(n => !isNaN(n)).sort((a, b) => a - b);
  
  res.json({ chunks });
});

// 上传分片
app.post('/chunks/:fileId/:chunkIndex', requireAuth, (req, res) => {
  const { fileId, chunkIndex } = req.params;
  const chunksDir = path.join(__dirname, 'chunks', fileId);
  
  // 创建分片目录
  if (!fs.existsSync(chunksDir)) {
    fs.mkdirSync(chunksDir, { recursive: true });
  }
  
  const chunkPath = path.join(chunksDir, chunkIndex);
  
  // 写入分片
  const writeStream = fs.createWriteStream(chunkPath);
  
  req.on('data', (chunk) => {
    writeStream.write(chunk);
  });
  
  req.on('end', () => {
    writeStream.end();
    res.json({ success: true, chunkIndex: parseInt(chunkIndex) });
  });
  
  req.on('error', (err) => {
    res.status(500).json({ error: err.message });
  });
});

// 合并分片
app.post('/merge/:fileId/:fileName', requireAuth, (req, res) => {
  const { fileId, fileName } = req.params;
  const chunksDir = path.join(__dirname, 'chunks', fileId);
  const finalDir = path.join(__dirname, 'uploads');
  
  if (!fs.existsSync(chunksDir)) {
    return res.status(400).json({ error: '分片不存在' });
  }
  
  // 获取所有分片
  const files = fs.readdirSync(chunksDir);
  const chunkIndexes = files.map(f => parseInt(f)).filter(n => !isNaN(n)).sort((a, b) => a - b);
  
  if (chunkIndexes.length === 0) {
    return res.status(400).json({ error: '没有分片' });
  }
  
  // 计算总大小
  let totalSize = 0;
  for (const idx of chunkIndexes) {
    const stats = fs.statSync(path.join(chunksDir, idx.toString()));
    totalSize += stats.size;
  }
  
  // 检查空间
  if (!hasSpace(totalSize)) {
    // 清理分片
    fs.rmSync(chunksDir, { recursive: true });
    return res.status(507).json({ error: '存储空间不足' });
  }
  
  // 生成最终文件名
  const timestamp = Date.now();
  const safeName = fileName.replace(/[^a-zA-Z0-9.\-_]/g, '_');
  const finalFileName = `${timestamp}-${safeName}`;
  const finalPath = path.join(finalDir, finalFileName);
  
  // 合并分片
  const writeStream = fs.createWriteStream(finalPath);
  
  let currentIndex = 0;
  
  function writeNextChunk() {
    if (currentIndex >= chunkIndexes.length) {
      writeStream.end();
      // 清理分片目录
      fs.rmSync(chunksDir, { recursive: true });
      return res.json({ success: true, filename: finalFileName, size: totalSize });
    }
    
    const chunkPath = path.join(chunksDir, chunkIndexes[currentIndex].toString());
    const readStream = fs.createReadStream(chunkPath);
    
    readStream.pipe(writeStream, { end: false });
    
    readStream.on('end', () => {
      currentIndex++;
      writeNextChunk();
    });
    
    readStream.on('error', (err) => {
      writeStream.end();
      res.status(500).json({ error: '合并失败: ' + err.message });
    });
  }
  
  writeNextChunk();
});

// 取消上传
app.delete('/chunks/:fileId', requireAuth, (req, res) => {
  const { fileId } = req.params;
  const chunksDir = path.join(__dirname, 'chunks', fileId);
  
  if (fs.existsSync(chunksDir)) {
    fs.rmSync(chunksDir, { recursive: true });
  }
  
  res.json({ success: true });
});

