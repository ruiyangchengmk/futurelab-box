  </style>
</head>
<body>
  <div class="container">
    <h1>🚀 FUTURELAB SHARING BOX</h1>
    <p class="subtitle">文件上传 · 随时随地 · 共享无限 · 断点续传</p>
    
    <div class="storage-info">
      <span>💾 已用: ${formatSize(usedSpace)}</span>
      <div class="storage-bar">
        <div class="storage-bar-fill" style="width: ${(usedSpace / MAX_STORAGE * 100).toFixed(1)}%"></div>
      </div>
      <span>📦 剩余: ${formatSize(remainingSpace)} / 10GB</span>
    </div>
    
    <div class="upload-box ${remainingSpace <= 0 ? 'disabled' : ''}" id="uploadBox">
      <form id="uploadForm">
        <label class="upload-btn">
          📤 选择文件上传
          <input type="file" name="file" id="fileInput">
        </label>
        <p style="margin-top: 15px; color: #888;">支持任意文件类型，单个文件最大 2GB，总空间 10GB<br>支持断点续传，刷新页面可继续上传</p>
      </form>
      <div id="uploadStatus" style="margin-top: 20px;"></div>
      
      <div class="progress-container" id="progressContainer">
        <div class="progress-text" id="progressText">准备上传...</div>
        <div class="progress-bar-wrap">
          <div class="progress-bar" id="progressBar"></div>
        </div>
        <div class="upload-controls">
          <button id="pauseBtn" style="display:none;">⏸ 暂停</button>
          <button id="resumeBtn" style="display:none;">▶️ 继续</button>
          <button id="cancelBtn">❌ 取消</button>
        </div>
      </div>
    </div>
    
    <div class="file-list">
      <h2>📁 已共享文件 (<span id="fileCount">${files.length}</span>)</h2>
      ${files.length === 0 ? '<p class="empty">暂无文件，快来上传第一个吧！</p>' : ''}
      ${files.map(f => `
        <div class="file-item">
          <div class="file-info">
            <div class="file-name">${f.name}</div>
            <div class="file-meta">${f.size} · ${f.date}</div>
          </div>
          <div class="file-actions">
            <a href="${f.url}" class="download-btn" download>⬇️ 下载</a>
            <button class="delete-btn" onclick="deleteFile('${f.name}')">🗑️ 删除</button>
          </div>
        </div>
      `).join('')}
    </div>
  </div>
  
  <script>
    // 格式化文件大小
    function formatSize(bytes) {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }
    
    const fileInput = document.getElementById('fileInput');
    const uploadStatus = document.getElementById('uploadStatus');
    const progressContainer = document.getElementById('progressContainer');
    const progressBar = document.getElementById('progressBar');
    const progressText = document.getElementById('progressText');
    const pauseBtn = document.getElementById('pauseBtn');
    const resumeBtn = document.getElementById('resumeBtn');
    const cancelBtn = document.getElementById('cancelBtn');
    
    let currentFile = null;
    let xhr = null; // 用于取消上传
    
    // 删除文件
    async function deleteFile(filename) {
      if (!confirm('确定要删除 ' + filename + ' 吗？此操作不可恢复！')) return;
      
      try {
        const res = await fetch('/delete/' + encodeURIComponent(filename), { method: 'DELETE' });
        const result = await res.json();
        if (result.success) {
          alert('✅ 文件已删除');
          location.reload();
        } else {
          alert('❌ 删除失败: ' + result.error);
        }
      } catch (err) {
        alert('❌ 删除失败: ' + err.message);
      }
    }
    
    // 更新进度条
    function updateProgress(percent, text) {
      progressBar.style.width = percent + '%';
      progressText.textContent = text;
    }
    
    // 简单上传函数
    function uploadFile(file) {
      return new Promise((resolve, reject) => {
        xhr = new XMLHttpRequest();
        
        // 进度事件
        xhr.upload.onprogress = function(e) {
          if (e.lengthComputable) {
            const percent = Math.round((e.loaded / e.total) * 100);
            updateProgress(percent, '上传中... ' + percent + '% (' + formatSize(e.loaded) + ' / ' + formatSize(e.total) + ')');
          }
        };
        
        // 上传完成
        xhr.onload = function() {
          if (xhr.status >= 200 && xhr.status < 300) {
            try {
              const result = JSON.parse(xhr.responseText);
              resolve(result);
            } catch(e) {
              resolve({success: true});
            }
          } else {
            reject(new Error('上传失败: ' + xhr.status));
          }
        };
        
        // 上传错误
        xhr.onerror = function() {
          reject(new Error('网络错误'));
        };
        
        // 发送表单数据
        const formData = new FormData();
        formData.append('file', file);
        
        xhr.open('POST', '/upload');
        xhr.send(formData);
      });
    }
    
    // 文件选择事件
    fileInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;
      
      // 确认弹窗
      var confirmed = confirm('确认上传文件：\n\n' + file.name + '\n大小：' + formatSize(file.size));
      if (!confirmed) {
        fileInput.value = '';
        return;
      }
      
      // 显示进度条
      progressContainer.classList.add('active');
      pauseBtn.style.display = 'none';
      resumeBtn.style.display = 'none';
      cancelBtn.style.display = 'inline-block';
      
      uploadStatus.innerHTML = '⏳ 准备上传...';
      updateProgress(0, '0%');
      
      // 开始上传
      uploadFile(file).then(function(result) {
        if (result.success) {
          uploadStatus.innerHTML = '✅ 上传成功！页面即将刷新...';
          setTimeout(function() { location.reload(); }, 1500);
        } else {
          uploadStatus.innerHTML = '❌ ' + (result.error || '上传失败');
        }
      }).catch(function(err) {
        uploadStatus.innerHTML = '❌ ' + err.message;
      }).finally(function() {
        cancelBtn.style.display = 'none';
        fileInput.value = '';
      });
    });
    
    // 取消按钮
    cancelBtn.addEventListener('click', function() {
      if (xhr) {
        xhr.abort();
        xhr = null;
      }
      progressContainer.classList.remove('active');
      uploadStatus.innerHTML = '❌ 已取消上传';
      fileInput.value = '';
      cancelBtn.style.display = 'none';
    });
  </script>
</body>
</html>`;
  
  res.send(html);
});

// 上传接口 (兼容旧版，需要登录)
app.post('/upload', requireAuth, upload.single('file'), (req, res) => {
  if (!req.file) {
    return res.status(400).json({ error: '没有文件' });
  }
  
  // 检查存储空间
  if (!hasSpace(req.file.size)) {
    // 删除刚上传的文件
    fs.unlinkSync(path.join(__dirname, 'uploads', req.file.filename));
    return res.status(507).json({ error: '存储空间不足，当前剩余: ' + formatSize(MAX_STORAGE - getUsedSpace()) });
  }
  
  res.json({ success: true, filename: req.file.filename });
});

// 下载统计
app.get('/stats', requireAuth, (req, res) => {
  const uploadsDir = path.join(__dirname, 'uploads');
  const files = fs.readdirSync(uploadsDir);
  res.json({ totalFiles: files.length });
});

// 删除文件
app.delete('/delete/:filename', requireAuth, (req, res) => {
  const filename = req.params.filename;
  const filePath = path.join(__dirname, 'uploads', filename);
  
  if (!fs.existsSync(filePath)) {
    return res.status(404).json({ error: '文件不存在' });
  }
  
  try {
    fs.unlinkSync(filePath);
    res.json({ success: true });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

app.listen(PORT, '0.0.0.0', () => {
  console.log(`🚀 FUTURELAB SHARING BOX running on http://0.0.0.0:${PORT}`);
  console.log(`📦 支持断点续传 - 分片大小: 5MB`);
});
